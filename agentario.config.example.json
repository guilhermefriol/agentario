{
  "$comment": "Copie para agentario.config.local.json (ignorado pelo git) e ajuste. Nomes abaixo são fictícios.",
  "agentarioLocal": false,
  "claudeDir": "~/.claude",
  "activeWindowSeconds": 120,
  "showRealNames": true,
  "showTasks": true,
  "layout": "acesas",
  "night": { "enabled": true, "from": "22:00", "to": "07:00" },
  "exclude": ["backup", "arquivo"],
  "projects": {
    "projeto-exemplo": { "label": "Projeto Exemplo", "tasks": "publico" },
    "projeto-interno": { "tasks": "interno" },
    "outro-projeto": { "hidden": true }
  }
}
